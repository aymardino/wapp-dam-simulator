# The domain comes from the DOMAIN variable of the .env file; Caddy obtains and renews the HTTPS certificate by itself.
{$DOMAIN:wapp-dam-simulator.mastereose.fr} {
    encode gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
    reverse_proxy api:8000
}

# For an apex domain of your own, add a `www.{$DOMAIN}` site block that redirects to the apex.
