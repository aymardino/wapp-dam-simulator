# The domain comes from the DOMAIN variable of the .env file; Caddy obtains and renews the HTTPS certificate by itself.
{$DOMAIN:wapp-dam-simulator.org} {
    encode gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
    reverse_proxy api:8000
}

www.{$DOMAIN:wapp-dam-simulator.org} {
    redir https://{$DOMAIN:wapp-dam-simulator.org}{uri} permanent
}
