{
  "name": "wapp-dam-video",
  "private": true,
  "type": "module",
  "description": "Motion design video of the WAPP DAM Simulator website, written in HTML and rendered with HyperFrames",
  "scripts": {
    "postinstall": "node scripts/sync-assets.mjs",
    "data": "python3 scripts/export_demo.py > assets/demo.json && node scripts/build-data.mjs",
    "lint": "hyperframes lint",
    "check": "hyperframes check",
    "preview": "hyperframes preview",
    "scene": "node scripts/scene-test.mjs",
    "render": "node scripts/render.mjs"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "5.2.8",
    "@fontsource/roboto": "5.2.8",
    "d3-geo": "3.1.1",
    "gsap": "3.14.2",
    "hyperframes": "0.8.164"
  }
}
